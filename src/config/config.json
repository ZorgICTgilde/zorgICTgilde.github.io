{
  "site": {
    "title": "ZorgICTgilde",
    "base_url": "https://zorgictgilde.nl",
    "base_path": "/",
    "trailing_slash": false,
    "favicon": "/images/favicon.png",
    "logo": "/images/ZorgICTgilde-logo.svg",
    "logo_darkmode": "/images/ZorgICTgilde-logo.svg",
    "logo_width": "300",
    "logo_height": "120",
    "logo_text": "ZorgICTgilde"
  },

  "settings": {
    "search": true,
    "sticky_header": true,
    "theme_switcher": true,
    "default_theme": "system",
    "pagination": 2,
    "summary_length": 200,
    "blog_folder": "blog"
  },

  "announcement": {
    "enable": true,
    "content": "<span class='text-center block'>♥️ Wil je een bijdragen leveren? <a class='underline' href='https://github.com/ZorgICTgilde/zorgICTgilde.github.io' target='_blank' rel='noopener'>Open hier onze Github</a></span>",
    "expire_days": 7
  },

  "params": {
    "contact_form_action": "#",
    "copyright": "Designed And Developed by [Zeon Studio](https://zeon.studio)"
  },

  "navigation_button": {
    "enable": true,
    "label": "Github",
    "link": "https://github.com/ZorgICTgilde/zorgICTgilde.github.io"
  },

  "google_tag_manager": {
    "enable": false,
    "gtm_id": "GTM-XXXXXX"
  },

  "disqus": {
    "enable": true,
    "shortname": "themefisher-template",
    "settings": {}
  },

  "metadata": {
    "meta_author": "zeon.studio",
    "meta_image": "/images/og-image.png",
    "meta_description": "astro and tailwind boilerplate"
  },

  "llms": {
    "generate_llms_txt": true,
    "generate_llms_full_txt": true,
    "generate_individual_md": true,
    "include": [],
    "exclude": []
  }
}
