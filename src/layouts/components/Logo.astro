---
import config from "@/config/config.json";
import ImageMod from "./ImageMod.astro";

const { src, srcDarkmode }: { src?: string; srcDarkmode?: string } =
  Astro.props;
const {
  logo,
  logo_darkmode,
  logo_width,
  logo_height,
  logo_text,
  title,
}: {
  logo: string;
  logo_darkmode: string;
  logo_width: any;
  logo_height: any;
  logo_text: string;
  title: string;
} = config.site;

const { theme_switcher }: { theme_switcher: boolean } = config.settings;

const lightLogo = src ? src : logo;
const darkLogo = srcDarkmode ? srcDarkmode : logo_darkmode;

const isLightSvg = lightLogo?.endsWith(".svg");
const isDarkSvg = darkLogo?.endsWith(".svg");

// Schoon de breedte en hoogte waarden op
const cleanWidth = Number(logo_width.toString().replace("px", ""));
const cleanHeight = Number(logo_height.toString().replace("px", ""));

// Klassen om het licht/donker logo te wisselen
const lightClass = `logo-img inline-block ${theme_switcher ? "dark:hidden" : ""}`;
const darkClass = "logo-img hidden dark:inline-block";
---

<a
  href="/"
  class="navbar-brand inline-flex items-center"
  style={`--logo-w:${cleanWidth}px;--logo-h:${cleanHeight}px`}
>
  {
    lightLogo || darkLogo ? (
      <>
        {isLightSvg ? (
          <img
            src={lightLogo}
            class={lightClass}
            alt={title}
            width={cleanWidth}
            height={cleanHeight}
          />
        ) : (
          <ImageMod
            src={lightLogo}
            class={lightClass}
            width={cleanWidth * 2}
            height={cleanHeight * 2}
            alt={title}
            format="webp"
          />
        )}

        {theme_switcher &&
          (isDarkSvg ? (
            <img
              src={darkLogo}
              class={darkClass}
              alt={title}
              width={cleanWidth}
              height={cleanHeight}
            />
          ) : (
            <ImageMod
              src={darkLogo}
              class={darkClass}
              width={cleanWidth * 2}
              height={cleanHeight * 2}
              alt={title}
              format="webp"
            />
          ))}
      </>
    ) : logo_text ? (
      logo_text
    ) : (
      title
    )
  }
</a>

<style is:global>
  /* Mobiel en tablet: logo op 50% van het formaat uit config.json.
     Pas 0.5 aan voor een groter of kleiner logo op kleine schermen. */
  .logo-img {
    width: calc(var(--logo-w) * 0.5);
    height: calc(var(--logo-h) * 0.5);
    object-fit: contain;
  }

  /* Desktop (lg, 1024px en breder): volledig formaat */
  @media (min-width: 1024px) {
    .logo-img {
      width: var(--logo-w);
      height: var(--logo-h);
    }
  }
</style>