---
import config from "@/config/config.json";
import ImageMod from "./ImageMod.astro";

const { src, srcDarkmode }: { src?: string; srcDarkmode?: string } =
  Astro.props;
const {
  logo,
  logo_darkmode,
  logo_width,
  logo_height,
  logo_text,
  title,
}: {
  logo: string;
  logo_darkmode: string;
  logo_width: any;
  logo_height: any;
  logo_text: string;
  title: string;
} = config.site;

const { theme_switcher }: { theme_switcher: boolean } = config.settings;

const lightLogo = src ? src : logo;
const darkLogo = srcDarkmode ? srcDarkmode : logo_darkmode;

const isLightSvg = lightLogo?.endsWith(".svg");
const isDarkSvg = darkLogo?.endsWith(".svg");

// Schoon de breedte en hoogte waarden op
const cleanWidth = logo_width.toString().replace("px", "");
const cleanHeight = logo_height.toString().replace("px", "");
---

<a href="/" class="navbar-brand inline-flex items-center">
  {
    lightLogo || darkLogo ? (
      <>
        {isLightSvg ? (
          <img
            src={lightLogo}
            class={`inline-block ${theme_switcher && "dark:hidden"}`}
            alt={title}
            width={cleanWidth}
            height={cleanHeight}
            style={{
              height: cleanHeight + "px",
              width: cleanWidth + "px",
              maxHeight: "100%",
              objectFit: "contain",
            }}
          />
        ) : (
          <ImageMod
            src={lightLogo}
            class={`inline-block ${theme_switcher && "dark:hidden"}`}
            width={cleanWidth * 2}
            height={cleanHeight * 2}
            alt={title}
            style={{
              height: cleanHeight + "px",
              width: cleanWidth + "px",
            }}
            format="webp"
          />
        )}

        {theme_switcher && (
          isDarkSvg ? (
            <img
              src={darkLogo}
              class={"hidden dark:inline-block"}
              alt={title}
              width={cleanWidth}
              height={cleanHeight}
              style={{
                height: cleanHeight + "px",
                width: cleanWidth + "px",
                maxHeight: "100%",
                objectFit: "contain",
              }}
            />
          ) : (
            <ImageMod
              src={darkLogo}
              class={"hidden dark:inline-block"}
              width={cleanWidth * 2}
              height={cleanHeight * 2}
              alt={title}
              style={{
                height: cleanHeight + "px",
                width: cleanWidth + "px",
              }}
              format="webp"
            />
          )
        )}
      </>
    ) : logo_text ? (
      logo_text
    ) : (
      title
    )
  }
</a>